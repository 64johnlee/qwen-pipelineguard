# Qwen / Alibaba Cloud DashScope API key
DASHSCOPE_API_KEY=sk-...

# GitLab personal access token (api + read_repository)
GITLAB_TOKEN=glpat-...

# Optional: Qwen model (default: qwen-plus)
# Options: qwen-max, qwen-plus, qwen-turbo, qwen-long
QWEN_MODEL=qwen-plus

# Optional: override GitLab instance URL
GITLAB_URL=https://gitlab.com
